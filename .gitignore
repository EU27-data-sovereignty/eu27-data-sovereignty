# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Local assistant config. Can carry absolute paths from this machine.
.claude/settings.local.json

# Env / secrets
.env
.env.*
!.env.example
# The Expo reader's template names the two EXPO_PUBLIC_ variables and ships no values; it has to
# be tracked or mobile/__tests__/security.test.ts, which reads it, cannot run in CI.
!mobile/.env.template

# Logs
*.log

# Python (in case tooling is added later)
__pycache__/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node (in case tooling is added later)
node_modules/

# Web app build output
web/node_modules/
web/dist/
.vercel/

# Expo reader (mobile/). Local-only: no build, no store listing, no deploy.
# node_modules/ above already covers the first of these; it is repeated because
# tests/test_ignore_rules.py asserts each one by name, and a rule that is only
# implied is a rule that disappears the next time the general one is edited.
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/.env.local

# Outreach contact lists. The institutional map is public (see README); files
# naming individuals are not: a public official's work contact is still personal
# data, and a public repo is a scrape target. See DECISIONS.md #26.
#
# contacts/ is a real directory again as of 2026-09-07, but it is NOT this
# repo's content: it is the working tree of the separate PRIVATE repo
# sovereign-data-centers-contacts, checked out here (DECISIONS.md #46). It
# carries its own .git and its own remote.
#
# That nested .git is the protection, not these two lines. Git will not descend
# into a directory containing .git, so even `git add -f contacts/` stages a
# mode-160000 gitlink -- 180 bytes naming a commit -- and never a single line of
# file content. A filename mistake can no longer leak a name, which is the
# failure mode #49 and #45 record happening twice.
#
# These rules are the second layer. They keep contacts/ out of `git status`, and
# *-contacts.md still catches a stray file written outside that directory. They
# are not a licence to keep personal data in this repo's own tree.
**/contacts/
*-contacts.md

# Playwright output
web/test-results/
web/playwright-report/

# Fetched source corpus (model/fetch.py). Rebuildable with `./run.sh fetch`, so
# the bytes stay out of git: national gazette PDFs are large and git history
# never shrinks. model/fetch_manifest.csv IS tracked and carries the sha256 of
# every file, which is what makes drift detectable without storing them.
# Mirrored in .vercelignore -- the CLI reads that INSTEAD of this file.
cache/

# Local Claude Code settings; the project skill under .claude/skills/ is tracked.
.claude/settings.local.json
