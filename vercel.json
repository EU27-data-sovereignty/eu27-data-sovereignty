{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./run.sh site",
  "outputDirectory": "web/dist",
  "functions": { "api/ask.ts": { "maxDuration": 60 } },
  "installCommand": "echo skip",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": { "silent": true },
  "git": { "deploymentEnabled": false },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    }
  ],
  "redirects": [{ "source": "/briefs/:iso.pdf", "destination": "/report/:iso.pdf", "permanent": true }],
  "rewrites": [{ "source": "/(.*)", "destination": "/index" }]
}
