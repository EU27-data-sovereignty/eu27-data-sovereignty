  "redirects": [
    {
      "source": "/briefs/:iso.pdf",
      "destination": "/report/:iso.pdf",
      "permanent": true
    },
    {
      "source": "/country/:iso",
      "destination": "/:iso",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index"
    }
  ]
}
